{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/certifications", "destination": "/certifications.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/news-classic", "destination": "/news-classic.html" },
    { "source": "/news", "destination": "/news-classic.html" },
    { "source": "/articles", "destination": "/portfolio.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
